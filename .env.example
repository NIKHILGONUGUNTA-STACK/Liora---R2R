# Environment variables for LLM provider(s)
export OPENAI_API_KEY=sk-...
#  uncomment the following lines to enable other LLM providers
# export ANTHROPIC_API_KEY=...
# export VERTEX_API_KEY=...
# export XAI_API_KEY=...
# Add other provider keys as needed

# Environment variables for the Postgres database
export R2R_POSTGRES_USER=your_user
export R2R_POSTGRES_PASSWORD=your_password
export R2R_POSTGRES_HOST=your_host
export R2R_POSTGRES_PORT=your_port
export R2R_POSTGRES_DBNAME=your_db
export R2R_PROJECT_NAME=your_project_name

# Email OTP Service (Standard SMTP - Gmail, SendGrid, Amazon SES, Mailgun, etc.)
export SMTP_HOST=smtp.gmail.com
export SMTP_PORT=587
export SMTP_USER=your_email@gmail.com
export SMTP_PASSWORD=your_app_specific_password
export SMTP_FROM=noreply@liora.io

# Google OAuth 2.0 Credentials
export GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
export GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Credentials
export GITHUB_CLIENT_ID=your-github-client-id
export GITHUB_CLIENT_SECRET=your-github-client-secret
